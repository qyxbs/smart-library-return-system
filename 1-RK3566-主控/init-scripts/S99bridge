#!/bin/sh
# S99bridge — K230 桥接服务（k230_bridge）
# 部署: /etc/init.d/S99bridge

PID_FILE="/var/run/k230_bridge.pid"
APP_DIR="/userdata/book_app"
APP_BIN="k230_bridge"
LOG_FILE="/var/log/k230_bridge.log"

start() {
    echo "Starting k230_bridge..."
    if [ -f "$PID_FILE" ]; then
        pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            echo "k230_bridge already running (pid=$pid)"
            return 0
        fi
        rm -f "$PID_FILE"
    fi

    cd "$APP_DIR"
    nohup "./$APP_BIN" >> "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
    echo "k230_bridge started (pid=$!)"
}

stop() {
    echo "Stopping k230_bridge..."
    if [ -f "$PID_FILE" ]; then
        pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            kill "$pid"
            sleep 2
            if kill -0 "$pid" 2>/dev/null; then
                kill -9 "$pid"
            fi
        fi
        rm -f "$PID_FILE"
    fi
}

status() {
    if [ -f "$PID_FILE" ]; then
        pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            echo "k230_bridge running (pid=$pid)"
            return 0
        fi
    fi
    echo "k230_bridge not running"
    return 1
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; sleep 1; start ;;
    status)  status ;;
    *)       echo "Usage: $0 {start|stop|restart|status}" ;;
esac
