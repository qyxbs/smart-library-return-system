#!/bin/sh
# S99book — 主控 HTTP 服务（book_server）
# 部署: /etc/init.d/S99book

PID_FILE="/var/run/book_server.pid"
APP_DIR="/userdata/book_app"
APP_BIN="book_server"
LOG_FILE="/var/log/book_server.log"

start() {
    echo "Starting book_server..."
    if [ -f "$PID_FILE" ]; then
        pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            echo "book_server already running (pid=$pid)"
            return 0
        fi
        rm -f "$PID_FILE"
    fi

    cd "$APP_DIR"
    nohup "./$APP_BIN" >> "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
    echo "book_server started (pid=$!)"
}

stop() {
    echo "Stopping book_server..."
    if [ -f "$PID_FILE" ]; then
        pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            kill "$pid"
            sleep 2
            if kill -0 "$pid" 2>/dev/null; then
                kill -9 "$pid"
            fi
        fi
        rm -f "$PID_FILE"
    fi
    fuser -k /dev/ttyS4 2>/dev/null || true
    fuser -k /dev/ttyS5 2>/dev/null || true
}

status() {
    if [ -f "$PID_FILE" ]; then
        pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            echo "book_server running (pid=$pid)"
            return 0
        fi
    fi
    echo "book_server not running"
    return 1
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; sleep 1; start ;;
    status)  status ;;
    *)       echo "Usage: $0 {start|stop|restart|status}" ;;
esac
