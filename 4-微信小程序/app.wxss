/**
 * 智能书架小程序 — 全局样式
 * 暗色主题，适配书架管理场景
 */

page {
  background-color: #0d1117;
  color: #c9d1d9;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

/* ==================== Utility ==================== */

.page-container {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

/* ==================== Cards ==================== */

.card {
  background: #161b22;
  border: 1px solid #30363d;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.card-header {
  font-size: 32rpx;
  font-weight: 600;
  color: #f0f6fc;
  margin-bottom: 16rpx;
}

/* ==================== Status Tags ==================== */

.status-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-on-shelf    { background: #1a3a1a; color: #3fb950; }
.status-borrowed    { background: #3a2a0a; color: #d29922; }
.status-pending     { background: #1a1a3a; color: #79c0ff; }
.status-overdue     { background: #3a1a1a; color: #f85149; }

/* ==================== Book Items ==================== */

.book-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #161b22;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  border: 1px solid #30363d;
}

.book-item:active {
  background: #1c2333;
}

.book-item-content {
  flex: 1;
  overflow: hidden;
}

.book-item-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #f0f6fc;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.book-item-meta {
  font-size: 24rpx;
  color: #8b949e;
  margin-top: 6rpx;
}

/* ==================== Empty States ==================== */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-state text {
  color: #484f58;
  font-size: 28rpx;
  margin-top: 16rpx;
}

/* ==================== Buttons ==================== */

.btn-primary {
  background: #238636;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-primary:active {
  background: #2ea043;
}

.btn-danger {
  background: #da3633;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  font-size: 30rpx;
}

.btn-outline {
  background: transparent;
  color: #58a6ff;
  border: 1px solid #30363d;
  border-radius: 12rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
}

/* ==================== QR Display ==================== */

.qr-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
}

.qr-canvas {
  width: 500rpx;
  height: 500rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.qr-hint {
  margin-top: 32rpx;
  color: #8b949e;
  font-size: 26rpx;
  text-align: center;
}
