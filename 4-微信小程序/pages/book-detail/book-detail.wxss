.title-bar { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 24rpx; border-bottom: 1px solid #21262d; }
.title-text { font-size: 34rpx; font-weight: 700; color: #f0f6fc; }

.book-header {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.book-info {
  flex: 1;
  overflow: hidden;
}

.book-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #f0f6fc;
  margin-bottom: 8rpx;
  word-break: break-all;
}

.book-meta {
  font-size: 26rpx;
  color: #8b949e;
}

.status-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-top: 1px solid #21262d;
}

.info-label {
  color: #8b949e;
  font-size: 26rpx;
}

.info-value {
  color: #c9d1d9;
  font-size: 26rpx;
  font-weight: 500;
}

.text-danger {
  color: #f85149;
}

.action-buttons {
  margin-top: 40rpx;
}

.no-action-hint {
  text-align: center;
  padding: 40rpx;
  color: #484f58;
  font-size: 28rpx;
}
