.title-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1px solid #21262d;
}

.title-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #f0f6fc;
}

.title-actions {
  display: flex;
  gap: 24rpx;
}

.status-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #161b22;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  border: 1px solid #30363d;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.status-dot.online  { background: #3fb950; }
.status-dot.offline { background: #f85149; }

.status-text {
  font-size: 26rpx;
  color: #c9d1d9;
  font-weight: 500;
}

.status-hint {
  font-size: 24rpx;
  color: #8b949e;
  margin-left: 8rpx;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 16rpx 8rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 4rpx;
}

.legend-dot.dashed {
  border: 2rpx dashed #30363d;
  background: transparent;
}

.legend-item text {
  font-size: 22rpx;
  color: #8b949e;
}
