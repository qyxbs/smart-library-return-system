.page-container {
  padding: 15px;
  background-color: #f7f8fa;
  min-height: 100vh;
}

.scan-section {
  margin-bottom: 16px;
}

.or-divider {
  text-align: center;
  color: #c8c9cc;
  font-size: 13px;
  margin: 12px 0;
}

.book-card {
  background: #fff;
  border-radius: 12px;
  padding: 16px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
}

.instance-id {
  font-size: 11px;
  color: #c8c9cc;
}

.card-body {
  margin-bottom: 16px;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 8px 0;
  border-bottom: 1px solid #f5f5f5;
  font-size: 14px;
}

.info-row .label {
  color: #969799;
}

.card-action {
  padding-top: 8px;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px 0;
}

.empty-text {
  color: #c8c9cc;
  font-size: 14px;
  margin-top: 12px;
}
