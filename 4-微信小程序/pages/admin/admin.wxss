.title-bar { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 24rpx; border-bottom: 1px solid #21262d; }
.title-text { font-size: 34rpx; font-weight: 700; color: #f0f6fc; }

.tab-bar {
  display: flex;
  background: #161b22;
  border-radius: 12rpx;
  border: 1px solid #30363d;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: #8b949e;
  border-bottom: 3rpx solid transparent;
}

.tab-item.active {
  color: #58a6ff;
  border-bottom-color: #58a6ff;
  background: rgba(88, 166, 255, 0.05);
}

/* User items */
.user-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #161b22;
  border-radius: 12rpx;
  margin-bottom: 10rpx;
  border: 1px solid #30363d;
}

.user-item-left {
  flex: 1;
  overflow: hidden;
  margin-right: 16rpx;
}

.user-item-name {
  font-size: 28rpx;
  color: #f0f6fc;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.user-item-meta {
  font-size: 22rpx;
  color: #8b949e;
  margin-top: 4rpx;
}

.text-admin { color: #d29922; }
.text-danger { color: #f85149; }
.text-primary { color: #58a6ff; }
.text-muted { color: #8b949e; }

/* Log items */
.log-item {
  padding: 16rpx 24rpx;
  background: #161b22;
  border-radius: 12rpx;
  margin-bottom: 10rpx;
  border: 1px solid #30363d;
}

.log-action {
  margin-bottom: 8rpx;
}

.log-content {
  font-size: 26rpx;
  color: #c9d1d9;
  line-height: 1.4;
}

.log-time {
  font-size: 22rpx;
  color: #484f58;
  margin-top: 6rpx;
}

/* Status dots */
.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.status-dot.online  { background: #3fb950; }
.status-dot.offline { background: #f85149; }

.user-actions { display: flex; gap: 12rpx; flex-shrink: 0; }
.popup-title { font-size: 32rpx; font-weight: 600; color: #f0f6fc; text-align: center; margin-bottom: 8rpx; }
.popup-hint { font-size: 24rpx; color: #8b949e; text-align: center; }
.popup-buttons { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 16rpx; }

.refresh-btn {
  text-align: center;
  padding: 32rpx;
  color: #58a6ff;
  font-size: 26rpx;
}
