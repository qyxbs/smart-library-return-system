.title-bar { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 24rpx; border-bottom: 1px solid #21262d; }
.title-text { font-size: 34rpx; font-weight: 700; color: #f0f6fc; }

.hint-banner {
  background: #1a2a1a;
  border: 1px solid #1f6f1f;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.hint-banner text {
  font-size: 24rpx;
  color: #7ee787;
  line-height: 1.5;
}

.select-all-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #161b22;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: #58a6ff;
  border: 1px solid #30363d;
}

.select-count {
  color: #8b949e;
}

.book-item {
  padding-left: 16rpx;
}

.checkbox-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid #30363d;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.checkbox-dot.checked {
  background: #238636;
  border-color: #238636;
  position: relative;
}

.checkbox-dot.checked::after {
  content: '✓';
  color: #fff;
  font-size: 20rpx;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.due-text.status-overdue {
  color: #f85149;
  font-weight: 600;
}

.submit-wrap {
  margin-top: 40rpx;
  padding-bottom: 40rpx;
}
