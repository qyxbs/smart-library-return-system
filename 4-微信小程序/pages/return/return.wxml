<view class="title-bar"><text class="title-text">还书</text></view>

<view class="page-container">
  <view class="hint-banner">
    <text>📋 请勾选要归还的书（默认全选），然后生成二维码出示给书架摄像头</text>
  </view>

  <view wx:if="{{ borrowed.length > 0 }}">
    <view class="select-all-row" bind:tap="onSelectAll">
      <text>{{ selectedIds.length === borrowed.length ? '取消全选' : '全选' }}</text>
      <text class="select-count">已选 {{ selectedIds.length }}/{{ borrowed.length }}</text>
    </view>

    <view class="book-item {{ getDueStatus(item.due_date) }}"
          wx:for="{{ borrowed }}" wx:key="instance_id"
          data-index="{{ index }}" bind:tap="onToggleSelect">
      <view class="checkbox-dot {{ selectedIds.indexOf(item.instance_id) > -1 ? 'checked' : '' }}">
      </view>
      <view class="book-item-content">
        <view class="book-item-title">{{ item.title }}</view>
        <view class="book-item-meta">
          借出: {{ item.borrow_time }}
          <text wx:if="{{ item.due_date }}" class="due-text {{ getDueStatus(item.due_date) }}">
            · 应还: {{ item.due_date }}
          </text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{ borrowed.length === 0 && !loading }}" class="empty-state">
    <text>📚</text>
    <text>没有待还的书</text>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-wrap" wx:if="{{ borrowed.length > 0 }}">
    <van-button type="primary" block round size="large"
                loading="{{ submitting }}"
                bind:click="onSubmit">
      生成还书二维码 ({{ selectedIds.length }}本)
    </van-button>
  </view>
</view>

<van-toast id="van-toast" />
