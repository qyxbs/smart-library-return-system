<van-nav-bar title="书籍录入" left-text="返回" left-arrow fixed placeholder />

<view class="page-container">
  <van-cell-group inset>
    <van-field
      label="书名"
      placeholder="请输入书名"
      value="{{ title }}"
      data-key="title"
      bind:change="onInputChange"
      required
    />
    <van-field
      label="作者"
      placeholder="选填"
      value="{{ author }}"
      data-key="author"
      bind:change="onInputChange"
    />
  </van-cell-group>

  <view class="section-title">书本分类</view>
  <van-radio-group value="{{ categoryIndex }}" bind:change="onCategoryChange">
    <van-cell-group inset>
      <van-cell
        wx:for="{{ categories }}"
        wx:key="index"
        title="{{ item }}"
        clickable
        data-index="{{ index }}"
        bind:click="onCategoryTap"
      >
        <van-radio name="{{ index }}" slot="right-icon" />
      </van-cell>
    </van-cell-group>
  </van-radio-group>

  <view class="submit-wrap">
    <van-button type="primary" block round bind:click="onSubmit">
      确认录入并打印标签
    </van-button>
  </view>
</view>

<van-toast id="van-toast" />
