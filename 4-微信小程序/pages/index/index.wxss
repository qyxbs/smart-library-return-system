.page-container {
  padding: 15px;
  background-color: #f7f8fa;
  min-height: 100vh;
}

.status-bar {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 12px;
}

.status-hint {
  font-size: 12px;
  color: #969799;
}

.action-bar {
  display: flex;
  gap: 8px;
  margin-bottom: 16px;
  flex-wrap: wrap;
}

.shelf-grid {
  background: #fff;
  border-radius: 12px;
  padding: 14px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}

.layer-label {
  font-size: 13px;
  font-weight: bold;
  color: #646566;
  margin: 10px 0 8px;
  padding-left: 4px;
}

.layer-label:first-child {
  margin-top: 0;
}

.slot-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.slot-box {
  width: calc(25% - 6px);
  min-height: 72px;
  border-radius: 10px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 6px 4px;
  box-sizing: border-box;
  transition: all 0.2s;
}

.slot-box:active {
  transform: scale(0.96);
}

.empty {
  background-color: #f5f5f5;
  border: 1px dashed #dcdee0;
}

.occupied {
  background-color: #e8ffea;
  border: 1px solid #07c160;
}

.slot-remark {
  font-size: 10px;
  color: #969799;
  margin-bottom: 2px;
}

.slot-title {
  font-size: 12px;
  color: #07c160;
  font-weight: bold;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-all;
}

.slot-empty {
  font-size: 13px;
  color: #c8c9cc;
}

.legend {
  display: flex;
  justify-content: center;
  margin-top: 16px;
}

.legend-item {
  display: flex;
  align-items: center;
  margin: 0 12px;
  font-size: 12px;
  color: #646566;
}

.dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  margin-right: 5px;
}

.green { background-color: #07c160; }
.gray { background-color: #dcdee0; }
