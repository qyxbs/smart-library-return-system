.shelf-grid {
  padding: 16rpx 0;
}

.layer-label {
  font-size: 24rpx;
  color: #8b949e;
  padding: 16rpx 8rpx 8rpx;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.slot-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.slot-box {
  width: calc(25% - 7.5rpx);  /* 4 per row */
  aspect-ratio: 1;
  border-radius: 12rpx;
  padding: 12rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  position: relative;
  overflow: hidden;
  border: 2rpx solid #30363d;
  transition: all 0.15s;
}

.slot-box.occupied {
  background: #161b22;
}

.slot-box.empty {
  background: #0d1117;
  border-style: dashed;
}

.slot-box:active {
  transform: scale(0.96);
  border-color: #58a6ff;
}

.slot-title {
  font-size: 24rpx;
  color: #c9d1d9;
  font-weight: 500;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
}

.slot-placeholder {
  font-size: 22rpx;
  color: #30363d;
}

.slot-remark {
  font-size: 18rpx;
  color: #484f58;
  margin-top: 4rpx;
}
